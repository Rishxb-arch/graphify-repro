+        "  def speak\n"
+        "    'meow'\n"
+        "  end\n"
+        "  def bark\n"
+        "    'hiss'\n"
+        "  end\n"
+        "end\n",
+        "Dog",
+        ".speak()",
+        ".bark()",
+    ),
+    (
+        "zoo.php",
+        "<?php\n"
+        "class Dog {\n"
+        "    function speak() { return $this->bark(); }\n"
+        "    function bark() { return 'woof'; }\n"
+        "}\n"
